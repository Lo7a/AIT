# מפתח GCP עם Places API (New) + PageSpeed Insights API מופעלים
GOOGLE_API_KEY=
# מפתח מ-Google AI Studio (שכבת חינם)
GEMINI_API_KEY=
# מודל ברירת המחדל לפיתוח
LLM_MODEL=gemini-3.6-flash

# חיבור Supabase (פרנקפורט) - DATABASE_URL דרך ה-pooler לזמן ריצה, DIRECT_URL למיגרציות
# SUPABASE_PASS: סיסמת ה-DB (לשימוש ידני בדשבורד; מחרוזות החיבור כבר מכילות אותה)
DATABASE_URL=
DIRECT_URL=
SUPABASE_PASS=

# יעד שליחת Project Brief (אבן דרך 4, משימה 7) - ריק => נופל לברירת המחדל lahavk@raion.co.il
# בקוד (src/server/run-brief.ts). תומך ברשימת נמענים מופרדת בפסיקים
BRIEF_EMAIL=
# מפתח API של Resend (צד שרת בלבד) - ריק => ה-Brief נכתב ללוג השרת בלבד (מצב פיתוח)
RESEND_API_KEY=
# כתובת השולח - ריק => onboarding@resend.dev (כתובת ה-sandbox הציבורית של Resend, לא סוד);
# כתובת מדומיין אמיתי דורשת אימות דומיין בדשבורד של Resend
BRIEF_FROM_EMAIL=

# Supabase Auth (אבן דרך "לצאת החוצה"): כתובת הפרויקט (https://<ref>.supabase.co) + המפתח
# הציבורי (publishable/anon) מהדשבורד: Settings -> API Keys. מפתחות צד-לקוח (NEXT_PUBLIC) -
# בטוחים לחשיפה בדפדפן. ריקים => האפליקציה רצה בלי התחברות (מסך הכניסה מציג הודעת הגדרה)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" רק אחרי יצירת Google OAuth Client וחיבורו בדשבורד Supabase (Authentication -> Providers)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# מפתח סודי של Supabase (צד שרת בלבד) - העלאות Storage לבאקט scan-artifacts
SUPABASE_SECRET_KEY=

# מעקף אימות לפיתוח מקומי בלבד (כבוי כברירת מחדל).
# מאפשר להריץ את הממשק ב-localhost בלי מפתחות Supabase: כל בקשה מזוהה כמשתמש
# פיתוח קבוע (dev@localhost, תפקיד owner). **רק הזהות מזויפת** - בעלות, תיחום,
# מגבלות קצב ויומן השימוש רצים בדיוק כמו למשתמש אמיתי.
# מת אוטומטית כש-NODE_ENV=production, גם אם המשתנה מוגדר. ערכים תקפים: 1 או owner.
# AIT_DEV_AUTH_BYPASS=1

# זהות הסוכן בערוץ הסוכנים (lahav-claude או elad-claude) - כל מכונה והערך שלה
AIT_AGENT_NAME=

# הלקוח הסמוי (משימה 10). הדומיין שממנו יוצאות פניות הבדיקה ואליו חוזרות התשובות
# (probe-<token>@<domain>) - חייב להיות מאומת ב-Resend גם לשליחה וגם לקבלה (רשומת MX).
# ריק => הפניות במייל לא נשלחות (הסבב מדלג על ערוץ המייל ואומר זאת)
MYSTERY_MAIL_DOMAIN=
# סוד ה-webhook של Resend (whsec_...) לאירוע email.received - ריק => הנתיב הנכנס סגור (503)
RESEND_WEBHOOK_SECRET=
# סוד לנקודת התקתוק השעתית (/api/mystery/tick) - pg_cron בסופאבייס שולח אותו בכותרת
# x-tick-secret. ריק => הנתיב סגור (503). מחרוזת אקראית ארוכה
MYSTERY_TICK_SECRET=
