# מפתח GCP עם Places API (New) + PageSpeed Insights API מופעלים
GOOGLE_API_KEY=
# מפתח מ-Google AI Studio (שכבת חינם)
GEMINI_API_KEY=
# מודל ברירת המחדל לפיתוח
LLM_MODEL=gemini-3.6-flash

# חיבור Supabase (פרנקפורט) - DATABASE_URL דרך ה-pooler לזמן ריצה, DIRECT_URL למיגרציות
# SUPABASE_PASS: סיסמת ה-DB (לשימוש ידני בדשבורד; מחרוזות החיבור כבר מכילות אותה)
DATABASE_URL=
DIRECT_URL=
SUPABASE_PASS=

# יעד שליחת Project Brief (אבן דרך 4, משימה 7) - ריק => נופל לברירת המחדל lahavk@raion.co.il
# בקוד (src/server/run-brief.ts). אין עדיין ספק מייל אמיתי - הזרקה בלבד עד שיהיה (Resend)
BRIEF_EMAIL=

# Supabase Auth (אבן דרך "לצאת החוצה"): כתובת הפרויקט (https://<ref>.supabase.co) + המפתח
# הציבורי (publishable/anon) מהדשבורד: Settings -> API Keys. מפתחות צד-לקוח (NEXT_PUBLIC) -
# בטוחים לחשיפה בדפדפן. ריקים => האפליקציה רצה בלי התחברות (מסך הכניסה מציג הודעת הגדרה)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" רק אחרי יצירת Google OAuth Client וחיבורו בדשבורד Supabase (Authentication -> Providers)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# מפתח סודי של Supabase (צד שרת בלבד) - העלאות Storage לבאקט scan-artifacts
SUPABASE_SECRET_KEY=
