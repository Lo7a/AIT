generator client {
  provider = "prisma-client-js"
}

// Supabase מגיע עם הרחבות מותקנות מראש ב-public (pg_stat_statements, pgcrypto, supabase_vault, uuid-ossp);
// ניהול הרחבות דרך Prisma (postgresqlExtensions) גורם ל-drift הרסני, לכן ההרחבה vector נוצרת ידנית בתוך המיגרציה (idempotent)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  placeId    String?     @unique @map("place_id")
  // זהות עסק אתר-בלבד: host מנורמל (websiteKeyOf) - upsert אטומי במקום findFirst+create
  websiteKey String?     @unique @map("website_key")
  website    String?
  phone      String?
  address    String?
  city       String?
  // בעלות (סלף-סרוויס, אבן דרך "לצאת החוצה"): בעל עסק רואה רק את העסקים שלו, אדמין רואה הכול.
  // nullable = אדיטיבי טהור - שורות הבדיקה הקיימות נשארות חוקיות עד ריצת הניקוי
  ownerUserId String?    @map("owner_user_id") @db.Uuid
  owner       User?      @relation(fields: [ownerUserId], references: [id])
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")
  diagnoses  Diagnosis[]

  @@index([ownerUserId])
  @@map("businesses")
}

// טבלת המראה של המשתמשים (החלטת ארכיטקטורה 16.8): הזהות המאומתת חיה ב-Supabase Auth (authId
// מצביע עליה), וכל הקשרים העסקיים במערכת מפנים אך ורק לטבלה הזו - כך החלפת ספק אימות עתידית
// נוגעת בשכבת הכניסה בלבד, לא בקשרים. role כמחרוזת פתוחה ("owner"/"admin" היום) - סוגי
// משתמשים של שלב ב נכנסים בלי שינוי סכמה. authId/email nullable: השורות נוצרות בחיווט הכניסה,
// והסכמה לא כופה סדר הקמה
model User {
  id          String       @id @default(uuid()) @db.Uuid
  authId      String?      @unique @map("auth_id") @db.Uuid
  email       String?      @unique
  role        String       @default("owner")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")
  businesses  Business[]
  events      UsageEvent[] @relation("event_subject")
  actedEvents UsageEvent[] @relation("event_actor")

  @@map("users")
}

// יומן פעולות (הוחלט 16.8): שלוש מטרות בטבלה אחת - היסטוריית משתמש, תשתית ההיטמאפס
// והסטטיסטיקות של שלב ב, ויומן ביקורת (אודיט). הפרדת actor/user לטובת מצב ההתחזות של האדמין:
// userId = בהקשר של איזה חשבון קרתה הפעולה, actorUserId = מי ביצע בפועל - שונים זה מזה רק
// בהתחזות, וכך כל פעולת התחזות מתועדת מעצם המבנה. אין אכיפת מכסות עכשיו (החלטת מייסד - סביבת
// טסט): הטבלה סופרת בלבד, והאכיפה תתחבר אליה בעתיד כמתג יחד עם המודל העסקי. שדות הישות
// (entityType/entityId) מחרוזות חופשיות בכוונה - היומן שורד שינויי סכמה עתידיים בלי מיגרציה
model UsageEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation("event_subject", fields: [userId], references: [id])
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("event_actor", fields: [actorUserId], references: [id])
  type        String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("usage_events")
}

model Diagnosis {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  business          Business           @relation(fields: [businessId], references: [id])
  // חייב להישאר זהה ל-DIAGNOSIS_STATUSES[0] ב-src/server/status.ts
  status            String             @default("created")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  scans             Scan[]
  interviewMessages InterviewMessage[]
  businessModel     BusinessModelRow?
  roadmaps          Roadmap[]

  @@index([businessId, status])
  @@map("diagnoses")
}

model Scan {
  id          String    @id @default(uuid()) @db.Uuid
  diagnosisId String    @map("diagnosis_id") @db.Uuid
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])
  findings    Json
  scores      Json?
  narrative   Json?
  // גוף גולמי (מקוצץ אצל PageSpeed) מהספקים - לשימוש עתידי, לא נצרך היום בשום מסך (אבן דרך 4, משימה 0.7)
  raw         Json?
  llmCost     Decimal?  @map("llm_cost") @db.Decimal(10, 4)
  apiCost     Decimal?  @map("api_cost") @db.Decimal(10, 4)
  durationMs  Int       @map("duration_ms")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([diagnosisId])
  @@map("scans")
}

model InterviewMessage {
  id          String    @id @default(uuid()) @db.Uuid
  diagnosisId String    @map("diagnosis_id") @db.Uuid
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])
  role        String
  content     String
  questionKey String?   @map("question_key")
  isFreeText  Boolean   @default(false) @map("is_free_text")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([diagnosisId, createdAt])
  @@map("interview_messages")
}

model BusinessModelRow {
  id              String    @id @default(uuid()) @db.Uuid
  diagnosisId     String    @unique @map("diagnosis_id") @db.Uuid
  diagnosis       Diagnosis @relation(fields: [diagnosisId], references: [id])
  data            Json
  fieldSources    Json      @map("field_sources")
  credits         Json
  completenessPct Int       @map("completeness_pct")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("business_models")
}

model Roadmap {
  id          String        @id @default(uuid()) @db.Uuid
  diagnosisId String        @map("diagnosis_id") @db.Uuid
  diagnosis   Diagnosis     @relation(fields: [diagnosisId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")
  items       RoadmapItem[]

  @@index([diagnosisId])
  @@map("roadmaps")
}

model RoadmapItem {
  id         String             @id @default(uuid()) @db.Uuid
  roadmapId  String             @map("roadmap_id") @db.Uuid
  roadmap    Roadmap            @relation(fields: [roadmapId], references: [id])
  catalogId  String             @map("catalog_id") @db.Uuid
  catalog    OpportunityCatalog @relation(fields: [catalogId], references: [id])
  score      Int
  confidence String
  phase      String
  // משפט נימוק אחד בעברית - למה ההזדמנות הזו רלוונטית לעסק הזה (אבן דרך 4, משימה 5). Nullable:
  // עמודה אדיטיבית, וגם כי שכבת ה-reasoning תמיד מייצרת ערך (LLM או תבנית) אבל העמודה נשארת
  // גמישה לעתיד (למשל ריצת backfill על שורות ישנות בלי הרצה מחדש של כל ה-Roadmap)
  reasoning  String?
  status     String             @default("proposed")
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at")
  briefs     Brief[]

  @@index([roadmapId, phase, score(sort: Desc)])
  @@index([catalogId])
  @@map("roadmap_items")
}

model Brief {
  id            String      @id @default(uuid()) @db.Uuid
  roadmapItemId String      @map("roadmap_item_id") @db.Uuid
  roadmapItem   RoadmapItem @relation(fields: [roadmapItemId], references: [id])
  content       String
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([roadmapItemId])
  @@map("briefs")
}

model OpportunityCatalog {
  id          String                       @id @default(uuid()) @db.Uuid
  name        String                       @unique
  problem     String
  solution    String
  conditions  Json
  costRange   String                       @map("cost_range")
  savingRange String                       @map("saving_range")
  complexity  String
  installTime String                       @map("install_time")
  embedding   Unsupported("vector(768)")?
  updatedAt   DateTime                     @default(now()) @updatedAt @map("updated_at")
  items       RoadmapItem[]
  benchmarks  Benchmark[]

  @@map("opportunity_catalog")
}

model Benchmark {
  id         String             @id @default(uuid()) @db.Uuid
  catalogId  String             @map("catalog_id") @db.Uuid
  catalog    OpportunityCatalog @relation(fields: [catalogId], references: [id])
  metric     String
  range      String
  source     String
  verifiedAt DateTime           @map("verified_at")
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([catalogId])
  @@map("benchmarks")
}
