{
  "name": "ait-pipeline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "scan": "tsx src/cli.ts",
    "diagnose": "tsx src/cli-diagnose.ts",
    "interview": "tsx src/cli-interview.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "chat:read": "tsx scripts/agent-chat.ts read",
    "chat:send": "tsx scripts/agent-chat.ts send",
    "chat:update": "tsx scripts/agent-chat.ts update",
    "chat:board": "tsx scripts/agent-chat.ts board",
    "tasks": "tsx scripts/agent-tasks.ts",
    "db:cleanup": "tsx prisma/cleanup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}
